DJANGO_SECRET_KEY=changeme-insecure-dev-key-with-at-least-32-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Banco PostgreSQL (docker compose up -d db).
# Deixe POSTGRES_DB vazio/removido para usar SQLite como fallback.
# POSTGRES_PORT usa a porta do host: 55433 evita conflito com um
# PostgreSQL nativo do Windows que escute em 5432/5433.
POSTGRES_DB=economiza_agora
POSTGRES_USER=economiza
POSTGRES_PASSWORD=economiza
POSTGRES_HOST=localhost
POSTGRES_PORT=55433

# Autenticação (JWT)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# URL base do frontend usada nos links de verificação/reset de senha.
FRONTEND_URL=http://localhost:3000

# E-mail (em desenvolvimento o backend é o console; não precisa configurar).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@economiza-agora.local

# Throttling (formato do DRF: número/período)
THROTTLE_ANON=60/min
THROTTLE_USER=120/min
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour
